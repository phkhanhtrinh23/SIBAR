# Copy to .env (git-ignored). With the defaults below everything runs offline with the
# deterministic oracle agent; the "Paper protocol" block shows the LLM setup of Section 5.1.

# One key for every OpenAI-compatible endpoint. A local vLLM server ignores it, but it must be
# non-empty whenever a backend is "openrouter".
OPENROUTER_API_KEY=

# ---- Frozen agent that answers follow-ups from its cache (C4) -----------------------
# oracle     : deterministic agent, restates cached values (no API calls, no cost)
# openrouter : LLM agent behind an OpenAI-compatible endpoint (OpenRouter or a local vLLM server)
AGENT_BACKEND=oracle
AGENT_MODEL=qwen/qwen-2.5-72b-instruct
AGENT_BASE_URL=

# ---- LLM that predicts needs for the ProAct-Pkg baseline ----------------------------
# oracle = label-frequency stand-in (no API calls)
PREDICTOR_BACKEND=oracle
PREDICTOR_MODEL=qwen/qwen-2.5-72b-instruct
PREDICTOR_BASE_URL=

# ---- Tokenizer for fact costs c(f) and the reply budget B ------------------------------
# tiktoken encoding (default cl100k_base) or a HuggingFace id, e.g. Qwen/Qwen2.5-14B-Instruct
SIBAR_TOKENIZER=

# ---- Paper protocol: Qwen2.5-14B-Instruct (temperature 0) served locally ----------------
#   vllm serve Qwen/Qwen2.5-14B-Instruct --port 8765 --max-model-len 8192 --seed 0
# OPENROUTER_API_KEY=local
# AGENT_BACKEND=openrouter
# AGENT_MODEL=Qwen/Qwen2.5-14B-Instruct
# AGENT_BASE_URL=http://localhost:8765/v1
# PREDICTOR_BACKEND=openrouter
# PREDICTOR_MODEL=Qwen/Qwen2.5-14B-Instruct
# PREDICTOR_BASE_URL=http://localhost:8765/v1
# SIBAR_TOKENIZER=Qwen/Qwen2.5-14B-Instruct
